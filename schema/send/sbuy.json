{
  "event": "sbuy",
  "source": "node/server.js:8326-8408",
  "request": {
    "fields": [
      {"name": "rid", "type": "string", "optional": false, "coerce": "compared with `==`", "description": "The listing id of the item: `rid` of a `ResaleItem` from `secondhands` or `lostandfound`."},
      {"name": "f", "type": "boolean", "optional": true, "description": "Any truthy value: buy from Lost and Found (`woffice`), not from Ponty."},
      {"name": "request_id", "type": "any", "optional": true, "description": "Any truthy value. Each failure becomes a `GameResponseFailure` with `request_id` and `rid`, a success sends a `data` reply, and Lost and Found checks your donation."}
    ],
    "others": "ignored",
    "example": {"rid": "Zt9Kp"},
    "confirm": {"code": ["node/server.js:8336-8344", "node/server.js:8346", "node/server.js:8349", "node/server.js:8366"], "note": "The handler reads `rid`, `f` and `request_id`"}
  },
  "responses": [
    {
      "name": "Success",
      "event": "game_response",
      "code": "data",
      "when": "All checks pass. The server takes the gold, adds the item with `src: \"scnd\"` (Ponty) or `\"lost\"` (Lost and Found) and removes the listing. `place` is the list, not `sbuy`. Only with `request_id`: without it, no `game_response` comes; the new `secondhands` (or `lostandfound`) list is the sign of success.",
      "with_request_id": {
        "extends": "GameResponseSuccess",
        "fields": [
          {"name": "response", "type": "\"data\"", "optional": false, "description": "Always `\"data\"`."},
          {"name": "place", "type": "\"secondhands\" | \"lostandfound\"", "optional": false, "description": "The list: `\"lostandfound\"` with `f`."},
          {"name": "success", "type": "true", "optional": false, "description": "Always `true`."},
          {"name": "request_id", "type": "any", "optional": false, "description": "A copy of `request_id`.", "example": "r1"},
          {"name": "rid", "type": "string", "optional": false, "description": "`rid` from the request."},
          {"name": "item", "type": "ResaleItem", "optional": false, "description": "The item that you bought."},
          {"name": "cost", "type": "integer", "optional": false, "description": "The gold paid: `calculate_item_value(item) * mult * (q || 1)`. `mult` is 2 at Ponty (3 for a `cash` item) and 4 at Lost and Found."}
        ],
        "example": {
          "request_id": "r1",
          "rid": "Zt9Kp",
          "item": {"name": "ringsj", "level": 2, "rid": "Zt9Kp"},
          "cost": 317312,
          "success": true,
          "response": "data",
          "place": "secondhands"
        }
      },
      "without_request_id": {"none": true},
      "source": "node/server.js:8394-8401",
      "confirm": {"code": ["node/server.js:8367-8370", "node/server.js:8394-8400", "node/server_functions.js:4234-4247", "node/server_functions.js:4203", "node/server_functions.js:3421-3446"], "note": "`success_response` is inside `if (data.request_id)` (node/server.js:8394); a live purchase without `request_id` got `game_log`, `player`, `secondhands` and `ui` but no `game_response`"}
    },
    {
      "name": "New list",
      "event": "secondhands",
      "when": "Success: the list without the item, without `f` (Ponty). It comes with and without `request_id`.",
      "type": "ResaleItem[]",
      "summary": "The same form as the reply of the `secondhands` request.",
      "example": [{"name": "wbook0", "rid": "aB3xQ"}],
      "source": "node/server.js:8391",
      "confirm": {"code": ["node/server.js:8331", "node/server.js:8384-8385", "node/server.js:8391"]}
    },
    {
      "name": "New list (Lost and Found)",
      "event": "lostandfound",
      "when": "Success with `f`: the Lost and Found list without the item. It comes with and without `request_id`.",
      "type": "ResaleItem[]",
      "summary": "The same form as the `lostandfound` list (the reply without `request_id`).",
      "example": [{"name": "staff", "level": 6, "rid": "Qe2Lm"}],
      "source": "node/server.js:8391",
      "confirm": {"code": ["node/server.js:8336-8341", "node/server.js:8384-8385", "node/server.js:8391"]}
    }
  ],
