            {"when": "The account of the other character is in your `friends` already, or it is your own account. Nothing changes.", "see": "Already friends", "source": "node/server.js:12038-12040", "confirm": {"code": ["node/server.js:12038-12040", "node/server_functions.js:3421-3446"]}}
          ]
