      {
        "value": "accept",
        "when": "Accepts a friend request that `name` sent to you. The server adds each account to the `friends` of the other, after the `in_progress` reply.",
        "request": {
          "fields": [
            {"name": "name", "type": "CharacterName", "optional": false, "coerce": "none: part of the key `name + \"-\" + your name` of the open requests", "description": "The exact name of the character that sent the request (the `name` of the `friend` `{event: \"request\"}` event)."},
