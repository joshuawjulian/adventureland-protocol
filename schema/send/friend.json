{
  "event": "friend",
  "source": "node/server.js:12027-12190",
  "request": {
    "fields": [
      {"name": "event", "type": "\"request\" | \"accept\" | \"unfriend\"", "optional": false, "coerce": "compared with `==`", "description": "The action. Another value gets only the `in_progress` reply."}
    ],
    "others": "ignored",
    "example": {"event": "unfriend"},
    "confirm": {"code": ["node/server.js:12033", "node/server.js:12045", "node/server.js:12118", "node/server.js:12189"], "note": "Only `event` is read here; each variant reads its own fields"}
  },
  "responses": [
    {
      "name": "In progress",
      "event": "game_response",
      "code": "data",
      "when": "At once, for `accept` (when the request exists), for `unfriend`, and for an unknown `event`. The database change of `accept` and `unfriend` runs after this reply. It does not carry `request_id`.",
      "fields": [
        {"name": "response", "type": "\"data\"", "optional": false, "description": "Always `\"data\"`."},
        {"name": "place", "type": "\"friend\"", "optional": false, "description": "The request."},
        {"name": "success", "type": "false", "optional": false, "description": "Always `false`: the change is not done yet."},
        {"name": "in_progress", "type": "true", "optional": false, "description": "Always `true`."}
      ],
      "example": {"success": false, "in_progress": true, "response": "data", "place": "friend"},
      "source": "node/server.js:12189",
      "confirm": {"code": ["node/server.js:12189", "node/server_functions.js:3421-3446"], "note": "`success_response` keeps `success: false` (it only sets `true` when `success !== false`)"}
    }
  ],
  "failures": {
    "event": "game_response",
    "place": "friend",
    "intro": "The `accept` and `unfriend` failures marked \"Later\" come after the `in_progress` reply, when the database work ends. They have no `place`, and `friend_failed` also has no `failed`. If you disconnect first, the server sends nothing.",
    "rows": [
      {"when": "No character.", "replies": [], "source": "node/server.js:12029-12031", "confirm": {"code": ["node/server.js:12029-12031"]}}
    ]
  },
  "variants": {
    "key": "event",
    "list": [
      {
        "value": "request",
        "when": "Asks a character on this server to be friends. The server keeps the request until the other character accepts it.",
        "request": {
          "fields": [
            {"name": "name", "type": "CharacterName", "optional": false, "coerce": "none: `data.name || \"\"`, used as a key of `name_to_id`", "description": "The exact name of a character online on this server."}
          ],
          "example": {"event": "request", "name": "Ranger"},
          "confirm": {"code": ["node/server.js:12034"]}
        },
        "responses": [
          {
            "name": "Request sent",
            "event": "game_response",
            "code": "friend_rsent",
            "when": "The request is stored, and the other character got `friend` `{event: \"request\"}`.",
            "extends": "GameResponseSuccess",
            "fields": [
              {"name": "response", "type": "\"friend_rsent\"", "optional": false, "description": "The code."},
              {"name": "place", "type": "\"friend\"", "optional": false, "description": "The request."},
              {"name": "success", "type": "true", "optional": false, "description": "Always `true`."}
            ],
            "example": {"success": true, "response": "friend_rsent", "place": "friend"},
            "source": "node/server.js:12041-12043",
            "confirm": {"code": ["node/server.js:12041-12043", "node/server_functions.js:3421-3446"]}
          },
          {
            "name": "Already friends",
            "event": "game_response",
            "code": "friend_already",
            "when": "The account of the other character is in your `friends` already, or it is your own account. Nothing changes. The reply has `success: true`, not `failed`.",
            "extends": "GameResponseSuccess",
            "fields": [
              {"name": "response", "type": "\"friend_already\"", "optional": false, "description": "The code."},
              {"name": "place", "type": "\"friend\"", "optional": false, "description": "The request."},
              {"name": "success", "type": "true", "optional": false, "description": "Always `true`."}
            ],
            "example": {"success": true, "response": "friend_already", "place": "friend"},
            "source": "node/server.js:12038-12040",
