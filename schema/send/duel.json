{
  "event": "duel",
  "source": "node/server.js:12191-12356",
  "request": {
    "fields": [
      {"name": "event", "type": "\"challenge\" | \"accept\" | \"enter\"", "optional": false, "coerce": "compared with `==`", "description": "The action. Any other value does nothing and sends no reply."},
      {"name": "request_id", "type": "any", "optional": true, "description": "Any truthy value. With it, failures are `game_response` objects, and `accept` and `enter` send a success reply. Without it, a failure is only a `game_log` text. The server copies it into its replies."}
    ],
    "others": "ignored",
    "example": {"event": "challenge", "request_id": "duel-1"},
    "confirm": {"code": ["node/server.js:12193-12196", "node/server.js:12197-12200", "node/server.js:12204", "node/server.js:12217", "node/server.js:12308-12309"]}
  },
  "failures": {
    "event": "game_response",
    "place": "duel",
    "intro": "With `request_id`, each failure is `{response: \"data\", place: \"duel\", failed: true, reason, request_id}`. Without `request_id`, the only reply is a `game_log` `LocalizedText`. Only the checks of the action in `event` run.",
    "rows": [
      {"when": "No character.", "replies": [], "source": "node/server.js:12201-12203", "confirm": {"code": ["node/server.js:12201-12203"]}}
    ]
  },
  "variants": {
