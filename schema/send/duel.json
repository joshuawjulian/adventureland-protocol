        "request": {
          "fields": [
            {"name": "id", "type": "CharacterName", "optional": true, "coerce": "none: `data.id || data.name`, used as a key of `name_to_id`", "description": "The character to challenge. The server uses it first, then `name`."},
            {"name": "name", "type": "CharacterName", "optional": true, "coerce": "none: `data.id || data.name`, used as a key of `name_to_id`", "description": "The character to challenge, when `id` is absent. Give `id` or `name`."}
          ],
          "example": {"event": "challenge", "name": "Ranger", "request_id": "duel-1"},
          "confirm": {"code": ["node/server.js:12205"]}
