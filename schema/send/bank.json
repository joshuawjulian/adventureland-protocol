          "fields": [
            {"name": "amount", "type": "integer", "optional": true, "default": 0, "coerce": "`max(0, min(parseInt(amount) || 0, your gold))`: a non-number is 0, and the server limits it to your gold", "description": "The gold to put into the bank.", "example": 100000}
