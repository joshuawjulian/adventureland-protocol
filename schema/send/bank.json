            "fields": [
              {"name": "response", "type": "\"bank_store\"", "optional": false, "description": "The code."},
              {"name": "gold", "type": "integer", "optional": false, "description": "The gold that moved from you to the bank."},
              {"name": "cevent", "type": "true", "optional": false, "description": "Always `true`."}
