{
  "event": "bank",
  "source": "node/server.js:9257-9483",
  "request": {
    "fields": [
      {"name": "operation", "type": "\"withdraw\" | \"deposit\" | \"unlock\" | \"move\" | \"swap\"", "optional": false, "coerce": "compared with `==`", "description": "The bank operation. It selects the variant. Any other value (or none) changes nothing and sends the **Success** reply."}
    ],
    "others": "ignored, except the fields of the variant",
    "example": {"operation": "withdraw"},
    "confirm": {"code": ["node/server.js:9266", "node/server.js:9272", "node/server.js:9278", "node/server.js:9371", "node/server.js:9400"]}
  },
  "variants": {
    "key": "operation",
    "intro": "Each variant reads only its own fields; the server ignores the others. Every variant ends with `player` (`reopen: true`) and a `game_response` `data`.",
    "list": [
      {
        "value": "withdraw",
        "when": "Takes gold from the bank.",
        "request": {
          "fields": [
            {"name": "amount", "type": "integer", "optional": true, "default": 0, "coerce": "`max(0, min(parseInt(amount) || 0, bank gold))`: a non-number is 0, and the server limits it to the gold in the bank", "description": "The gold to take from the bank.", "example": 100000}
          ],
          "example": {"operation": "withdraw", "amount": 50000},
          "confirm": {"code": ["node/server.js:9266-9267"]}
        },
        "responses": [
          {
            "name": "Withdraw data",
            "event": "game_response",
            "code": "data",
            "when": "The gold moved from the bank to you. The `bank_withdraw` reply follows at once.",
            "extends": "GameResponseSuccess",
            "fields": [
              {"name": "response", "type": "\"data\"", "optional": false, "description": "Always `\"data\"`."},
              {"name": "place", "type": "\"bank\"", "optional": false, "description": "The request."},
              {"name": "success", "type": "true", "optional": false, "description": "Always `true`."},
              {"name": "gold", "type": "integer", "optional": false, "description": "The gold moved, after the server limited `amount`. It can be 0."},
              {"name": "cevent", "type": "true", "optional": false, "description": "Always `true`."}
            ],
            "example": {"gold": 50000, "cevent": true, "success": true, "response": "data", "place": "bank"},
            "source": "node/server.js:9266-9271, 9481",
            "confirm": {"code": ["node/server.js:9267-9270", "node/server.js:9479-9481", "node/server_functions.js:3421-3446"], "note": "`success_response` replaces `response` with `\"data\"` and adds `success` and `place`"}
          },
          {
            "name": "Withdraw",
            "event": "game_response",
            "code": "bank_withdraw",
            "when": "After the `data` reply.",
            "fields": [
              {"name": "response", "type": "\"bank_withdraw\"", "optional": false, "description": "The code."},
              {"name": "gold", "type": "integer", "optional": false, "description": "The gold that moved from the bank to you."},
              {"name": "cevent", "type": "true", "optional": false, "description": "Always `true`."}
            ],
            "example": {"response": "bank_withdraw", "gold": 50000, "cevent": true},
            "source": "node/server.js:9270, 9482",
            "confirm": {"code": ["node/server.js:9270", "node/server.js:9479", "node/server.js:9482"], "note": "A copy taken before `success_response` changes the object"}
          }
        ],
        "order": [
          "`player` with `reopen: true` to you",
          "`game_response` `data` with `gold` to you",
          "`game_response` `bank_withdraw` to you"
        ],
        "source": "node/server.js:9266-9271"
      },
      {
        "value": "deposit",
        "when": "Puts gold into the bank.",
