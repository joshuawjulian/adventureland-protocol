{
  "event": "say",
  "source": "node/server.js:5092-5125",
  "request": {
    "fields": [
      {"name": "message", "type": "string", "optional": false, "coerce": "`typeof message !== \"string\"` fails with `invalid`. Then `strip_string(message).substr(0, 1200)`: the server removes control characters and combining marks (node/server_functions.js:5654-5662)", "description": "The chat text. It must not be empty after the server cleans it."},
      {"name": "party", "type": "any", "optional": true, "coerce": "tested as true or false", "description": "Selects the path. If truthy, the message goes to your party, and the server ignores `name`. If falsy, `name` selects a private message, and no `name` a public message."},
      {"name": "code", "type": "any", "optional": true, "coerce": "tested as true or false", "description": "If truthy, the message counts as sent from code: it needs 15 s since your last message."}
    ],
    "others": "ignored",
    "example": {"message": "hello"}, "confirm": {"code": ["node/server.js:5097-5099", "node/server.js:5109", "node/server.js:5115-5116", "node/server_functions.js:5654-5664"]}
  },
  "responses": [
    {
      "name": "Success",
      "event": "game_response",
      "code": "data",
      "when": "The message went out. For a private message, the reply does not wait for the delivery to another server.",
      "extends": "GameResponseSuccess",
      "fields": [
        {"name": "response", "type": "\"data\"", "optional": false, "description": "Always `\"data\"`."},
        {"name": "place", "type": "\"say\"", "optional": false, "description": "The request."},
        {"name": "success", "type": "true", "optional": false, "description": "Always `true`."}
      ],
      "example": {"success": true, "response": "data", "place": "say"},
      "source": "node/server.js:5124", "confirm": {"code": ["node/server.js:5124", "node/server_functions.js:3421-3446"]}
    }
  ],
  "failures": {
    "event": "game_response",
    "rows": [
      {"when": "No character, or your character has the `mute` condition.", "code": "muted", "source": "node/server.js:5094-5096", "confirm": {"code": ["node/server.js:5093-5096", "node/server_functions.js:3393-3419"]}},
      {"when": "The payload is `null`, or `message` is not a string.", "code": "invalid", "source": "node/server.js:5097", "confirm": {"code": ["node/server.js:5097", "node/server_functions.js:3393-3419"]}},
      {"when": "`code` is truthy and your last message was less than 15 s ago.", "code": "chat_slowdown", "source": "node/server.js:5099-5101", "confirm": {"code": ["node/server.js:5099-5101", "node/server_functions.js:3393-3419"]}},
      {"when": "Your last message was less than 400 ms ago.", "code": "chat_slowdown", "source": "node/server.js:5102-5104", "confirm": {"code": ["node/server.js:5102-5104", "node/server_functions.js:3393-3419"]}},
      {"when": "The message is empty after the server cleans it.", "code": "invalid", "source": "node/server.js:5105-5107", "confirm": {"code": ["node/server.js:5098", "node/server.js:5105-5107", "node/server_functions.js:3393-3419"]}},
      {"branch": true, "when": "The server records the time of the message (`last_say`), then runs the checks of the variant. Each failure here also counts for the 400 ms limit.", "source": "node/server.js:5108"}
    ]
  },
  "also": [
    {"event": "player", "to": "you", "when": "Your character had the `typing` condition. The server removes it, before the `game_response`.", "summary": "Your character without `s.typing`.", "source": "node/server.js:5120-5123", "confirm": {"code": ["node/server.js:5120-5123", "node/server.js:4550-4594"]}}
  ],
  "variants": {
