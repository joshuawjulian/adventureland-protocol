{
  "event": "locksmith",
  "source": "node/server.js:6791-6861",
  "request": {
    "fields": [
      {"name": "num", "type": "InventoryIndex", "optional": false, "coerce": "none: used as an array key, so `\"6\"` also works. Any other value reads an empty slot", "description": "The slot of the item."},
      {"name": "operation", "type": "\"lock\" | \"seal\" | \"unlock\"", "optional": false, "coerce": "compared with `==`", "description": "What to do. Each value is a variant (below). Another value changes nothing, takes no gold and gets the `data` success reply."},
      {"name": "item_num", "type": "any", "optional": true, "description": "No effect. The handler reads `player.items[item_num]` first, then uses the item at `num`."}
