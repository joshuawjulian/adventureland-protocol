            {"when": "On an item with `l: \"l\"`. Your gold is less than 250,000.", "code": "gold_not_enough", "source": "node/server.js:6831-6834", "confirm": {"code": ["node/server.js:6831-6834", "node/server_functions.js:3393-3419"]}}
