    "confirm": {"code": ["node/server.js:6793", "node/server.js:6801", "node/server.js:6809", "node/server.js:6839", "node/server.js:6850"], "note": "The handler reads `item_num` (unused after), `num` and `operation`"}
  },
  "variants": {
