      {"when": "You are more than `B.sell_dist` (400 px) from the `locksmith` NPC on `desertland`. A character with a `computer` passes this check.", "code": "distance", "source": "node/server.js:6798-6800", "confirm": {"code": ["node/server.js:6798-6800", "node/server.js:220", "node/server_functions.js:3393-3419"]}},
      {"when": "The slot `num` is empty.", "code": "no_item", "source": "node/server.js:6801-6804", "confirm": {"code": ["node/server.js:6801-6804", "node/server_functions.js:3393-3419"]}},
      {"when": "The item is of type `uscroll`, `cscroll`, `pscroll`, `offering` or `tome`.", "code": "locksmith_cant", "source": "node/server.js:6805-6808", "confirm": {"code": ["node/server.js:6805-6808", "node/server_functions.js:3393-3419"]}}
