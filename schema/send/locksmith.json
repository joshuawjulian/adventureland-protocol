          {"name": "Unseal complete", "event": "game_response", "code": "locksmith_unseal_complete", "when": "On an item with `l: \"u\"` after the time in `ld`: the server deletes `l`. It takes no gold.", "type": "\"locksmith_unseal_complete\"", "example": "locksmith_unseal_complete", "source": "node/server.js:6826", "confirm": {"code": ["node/server.js:6822-6826"]}},
          {
