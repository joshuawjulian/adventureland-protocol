      {
        "when": "`mode.prevent_external` is on (the `HARDCORE` and `TEST` servers).",
        "code": "not_in_this_server",
        "form": "plain",
        "extra": [
          {"name": "id", "type": "string", "optional": false, "description": "The `id` of the request.", "example": "ML_k3Jx9QpLm2vT8wYz0aBcDeFgHiJkLmNoPqRsTuVwXyZ01234"},
          {"name": "request_id", "type": "any", "optional": true, "description": "The `request_id` of the request.", "example": 1},
          {"name": "failed", "type": "true", "optional": false, "description": "Always `true`."},
          {"name": "reason", "type": "\"not_in_this_server\"", "optional": false, "description": "Why."}
        ],
        "source": "node/server.js:5629-5631", "confirm": {"code": ["node/server.js:5629-5631", "node/server.js:5602-5614", "node/server.js:297", "node/server.js:382", "node/server.js:393"]}
      },
      {
