        "form": "plain",
        "extra": [
          {"name": "id", "type": "string", "optional": false, "description": "The `id` of the request.", "example": "ML_k3Jx9QpLm2vT8wYz0aBcDeFgHiJkLmNoPqRsTuVwXyZ01234"},
          {"name": "request_id", "type": "any", "optional": true, "description": "The `request_id` of the request.", "example": 1},
          {"name": "failed", "type": "true", "optional": false, "description": "Always `true`."},
          {"name": "reason", "type": "\"invalid_mail\"", "optional": false, "description": "Why."}
        ],
        "source": "node/server.js:5640", "confirm": {"code": ["node/server.js:5639-5640", "node/server.js:5602-5614"]}
      },
      {
        "when": "Transaction: the mail is not for your account, or it is for another character of the account. Or the transaction failed with an error (`exception`) and nobody took the mail. `claim_failed` is the fallback when `tx` gives no reason; `tx` always gives one.",
        "code": "mail_take_item_failed",
        "form": "plain",
        "extra": [
          {"name": "id", "type": "string", "optional": false, "description": "The `id` of the request.", "example": "ML_k3Jx9QpLm2vT8wYz0aBcDeFgHiJkLmNoPqRsTuVwXyZ01234"},
          {"name": "request_id", "type": "any", "optional": true, "description": "The `request_id` of the request.", "example": 1},
          {"name": "failed", "type": "true", "optional": false, "description": "Always `true`."},
          {"name": "reason", "type": "\"not_owner\" | \"wrong_character\" | \"exception\" | \"claim_failed\"", "optional": false, "description": "Why.", "example": "not_owner"},
          {"name": "cevent", "type": "\"mail_take_item_failed\"", "optional": false, "description": "Tells the official client to fire its code event."}
        ],
        "source": "node/server.js:5644-5646, 5655-5663", "confirm": {"code": ["node/server.js:5644-5646", "node/server.js:5655-5663", "node/server.js:5602-5614", "common:mongodb_functions.js:71-74", "common:mongodb_functions.js:88-95"]}
      },
      {
        "when": "Transaction: the mail has no item, or somebody took it already (also after an `exception` when somebody took the mail now).",
        "code": "mail_item_already_taken",
        "form": "plain",
        "extra": [
          {"name": "id", "type": "string", "optional": false, "description": "The `id` of the request.", "example": "ML_k3Jx9QpLm2vT8wYz0aBcDeFgHiJkLmNoPqRsTuVwXyZ01234"},
          {"name": "request_id", "type": "any", "optional": true, "description": "The `request_id` of the request.", "example": 1},
          {"name": "failed", "type": "true", "optional": false, "description": "Always `true`."},
          {"name": "reason", "type": "\"no_item\" | \"already_taken\"", "optional": false, "description": "Why.", "example": "already_taken"}
        ],
        "source": "node/server.js:5645-5647, 5655-5661", "confirm": {"code": ["node/server.js:5645-5647", "node/server.js:5655-5662", "node/server.js:5602-5614", "common:mongodb_functions.js:71-74", "common:mongodb_functions.js:88-95"]}
      },
      {
        "when": "The attachment is not a valid item and not valid gold. The handler calls `ex(\"invalid_item\")` outside a transaction, where `ex` does not exist; the `catch` releases the claim.",
