          {"name": "request_id", "type": "any", "optional": true, "description": "The `request_id` of the request.", "example": 1},
          {"name": "failed", "type": "true", "optional": false, "description": "Always `true`."},
          {"name": "reason", "type": "\"inv_size\"", "optional": false, "description": "Why."}
        ],
        "source": "node/server.js:5673-5678", "confirm": {"code": ["node/server.js:5673-5678", "node/server.js:5602-5614"]}
      },
      {
