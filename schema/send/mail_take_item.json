        ],
        "source": "node/server.js:5672, 5690-5704", "confirm": {"code": ["node/server.js:5666-5672", "node/server.js:5690-5704", "node/server.js:5602-5614"], "note": "No global `ex` exists in the server code, so the call throws a `ReferenceError`"}
      },
      {
        "when": "Your inventory has no space for the item (`can_add_item`). The server releases the claim, so you can try again. If your character left, the server releases the claim and sends nothing.",
