{
  "event": "mail_take_item",
  "source": "node/server.js:5599-5707",
  "request": {
    "fields": [
      {"name": "id", "type": "string", "optional": false, "coerce": "a database id: `get(id)`", "description": "The id of the mail, `\"ML_\"` and 50 random characters (from the mail list of the account)."},
      {"name": "request_id", "type": "any", "optional": true, "description": "Copied unchanged into every reply. Not tested as true or false: any value except `undefined` appears."}
    ],
    "others": "ignored",
    "example": {"id": "ML_k3Jx9QpLm2vT8wYz0aBcDeFgHiJkLmNoPqRsTuVwXyZ01234", "request_id": 1}, "confirm": {"code": ["node/server.js:5601", "node/server.js:5607-5608", "node/server.js:5639"]}
  },
  "responses": [
    {
      "name": "Success",
      "event": "game_response",
      "code": "mail_item_taken",
      "when": "The claim succeeded: the server marked the mail as taken in a transaction and added the attachment. It comes after a `player` update with `reopen`. The claim is asynchronous.",
      "fields": [
        {"name": "response", "type": "\"mail_item_taken\"", "optional": false, "description": "The code. The object has no `place`."},
        {"name": "id", "type": "string", "optional": false, "description": "The `id` of the request."},
        {"name": "request_id", "type": "any", "optional": true, "description": "The `request_id` of the request."},
        {"name": "success", "type": "true", "optional": false, "description": "Always `true`."},
        {"name": "item", "type": "ItemInstance", "optional": true, "description": "The item (`cache_item`). Absent for a gold attachment."},
        {"name": "gold", "type": "integer", "optional": true, "description": "Only for a gold attachment: the gold. Only award mail of the Cave of Many Dreams carries gold, at most `G.events.dreams.gold_limit`."},
        {"name": "cevent", "type": "\"mail_item_taken\"", "optional": false, "description": "Tells the official client to fire its code event."}
      ],
      "example": {"response": "mail_item_taken", "id": "ML_k3Jx9QpLm2vT8wYz0aBcDeFgHiJkLmNoPqRsTuVwXyZ01234", "request_id": 1, "success": true, "item": {"name": "blade", "level": 7}, "cevent": "mail_item_taken"},
      "source": "node/server.js:5602-5614, 5686-5689, 5698-5703", "confirm": {"code": ["node/server.js:5602-5614", "node/server.js:5679-5689", "node/server.js:5697-5703", "node/server_functions.js:4234-4261"]}
    }
  ],
  "failures": {
