{
  "event": "gm",
  "source": "node/server.js:5282-5394",
  "request": {
    "fields": [
      {"name": "action", "type": "\"mute\" | \"jail\" | \"ban\" | \"invincible\" | \"jump\" | \"mjump\" | \"jump_list\" | \"server_info\"", "optional": false, "coerce": "compared with `==`; another value does nothing", "description": "The command. It selects the variant."}
    ],
    "others": "ignored. The handler reads `id` for every `action` (`players[id_to_id[data.id]]`), but only `mute`, `jail` and `jump` use the result",
    "example": {"action": "jump_list"}, "confirm": {"code": ["node/server.js:5287-5288"]}
  },
  "failures": {
    "event": "game_log",
    "intro": "There is no `game_response`. Errors are `game_log` events with a `LocalizedText`.",
    "rows": [
      {"when": "No character, or your `role` is not `\"gm\"`.", "replies": [], "source": "node/server.js:5284-5286", "confirm": {"code": ["node/server.js:5283-5286"]}}
    ]
  },
  "variants": {
    "key": "action",
    "intro": "GMs only: a character whose `role` is not `\"gm\"` gets no reply for any `action`.",
    "list": [
      {
        "value": "mute",
        "when": "Mutes the target for 48 h, or unmutes it.",
        "request": {
          "fields": [
            {"name": "id", "type": "CharacterName", "optional": false, "coerce": "`players[id_to_id[id]]`: an online character on this server", "description": "The target character."}
