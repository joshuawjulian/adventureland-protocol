            "example": {"message": "Muted SomePlayer", "phrase": "server.game_chat.muted", "phrase_args": {"target": "SomePlayer"}},
            "source": "node/server.js:5296-5301", "confirm": {"code": ["node/server.js:5296-5301", "languages/index.js:256-258"]}
          },
          {
            "name": "Unmuted",
            "event": "game_chat",
            "when": "The target had `mute`. The server sets its time to 0.",
            "type": "LocalizedText",
            "example": {"message": "Unmuted SomePlayer", "phrase": "server.game_chat.unmuted", "phrase_args": {"target": "SomePlayer"}},
            "source": "node/server.js:5302-5307", "confirm": {"code": ["node/server.js:5302-5307", "languages/index.js:256-258"]}
          }
        ],
        "failures": {
