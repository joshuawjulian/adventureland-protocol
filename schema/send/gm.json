          "example": {"action": "mute", "id": "SomePlayer"}, "confirm": {"code": ["node/server.js:5287-5290"]}
        },
        "responses": [
          {
            "name": "Muted",
            "event": "game_chat",
            "when": "The target had no `mute` condition. The server gives it `mute` for 48 h.",
