<!-- PartyMerchant.csproj: one program of the course. Top-level statements in Program.cs.
     The run command is in the first comment of Program.cs. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- The albot library (namespace Albot). -->
    <ProjectReference Include="../Albot/Albot.csproj" />
  </ItemGroup>
</Project>
